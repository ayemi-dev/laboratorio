{
  "version": 1,
  "author": "Ayemi",
  "editor": "wokwi",
  "parts": [
    {
      "id": "esp",
      "type": "board-esp32-devkit-c-v4",
      "top": 0,
      "left": 0,
      "attrs": {
        "env": "micropython-20260406-v1.28.0"
      }
    },
    {
      "id": "sensor",
      "type": "wokwi-dht22",
      "top": -20,
      "left": 190,
      "attrs": {
        "temperature": "24",
        "humidity": "40"
      }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "sensor:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "sensor:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "sensor:SDA", "esp:15", "green", [ "v0" ] ]
  ]
}
